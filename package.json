{
  "name": "onzio-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Secure multi-tenant club website platform, bootstrapped from the Rose City FC application.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:legacy": "vitest run lib/__tests__",
    "test:contracts": "vitest run tests/contracts",
    "test:db": "SUPABASE_LOCAL=1 vitest run tests/database",
    "test:architecture": "vitest run tests/architecture",
    "test:browser:roster": "playwright test --config=playwright.roster.config.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema onzio > lib/database.generated.ts",
    "db:types:check": "node scripts/check-database-types.mjs",
    "media:cleanup": "tsx scripts/cleanup-staging-media.ts",
    "media:smoke": "tsx scripts/smoke-media-pipeline.ts",
    "operator:smoke": "tsx scripts/smoke-operator-workflows.ts",
    "staging:provision": "tsx scripts/provision-phase-7-staging.ts",
    "staging:verify:auth": "tsx scripts/verify-phase-7-hosted-auth.ts",
    "staging:verify:lifecycle": "tsx scripts/verify-phase-7-lifecycle.ts",
    "staging:verify:media": "tsx scripts/verify-phase-7-media.ts",
    "staging:verify:stripe": "tsx scripts/verify-phase-7-stripe-webhook.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@vercel/analytics": "^2.0.1",
    "chart.js": "^4.5.1",
    "flag-icons": "^7.5.0",
    "gsap": "^3.12.5",
    "next": "15.5.22",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.0",
    "stripe": "^22.3.2",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^8",
    "eslint-config-next": "15.5.22",
    "pngjs": "^7.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.18",
      "sharp": "0.35.0"
    }
  }
}

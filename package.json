{
  "name": "onzio-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Secure multi-tenant club website platform, bootstrapped from the Rose City FC application.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:legacy": "vitest run lib/__tests__",
    "test:contracts": "vitest run tests/contracts",
    "test:db": "SUPABASE_LOCAL=1 vitest run tests/database",
    "test:architecture": "vitest run tests/architecture",
    "test:browser:roster": "playwright test --config=playwright.roster.config.ts",
    "test:browser:dcfc-304": "playwright test --config=playwright.dcfc-304.config.ts",
    "test:browser:dcfc-403": "playwright test --config=playwright.dcfc-403.config.ts",
    "test:browser:plat-101": "playwright test --config=playwright.plat-101.config.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema onzio > lib/database.generated.ts",
    "db:types:check": "node scripts/check-database-types.mjs",
    "db:rehearse:plat-101": "node scripts/rehearse-plat-101-rollback.mjs",
    "media:cleanup": "tsx scripts/cleanup-staging-media.ts",
    "media:smoke": "tsx scripts/smoke-media-pipeline.ts",
    "migration:export:rose-city": "node scripts/export-rose-city-rehearsal.mjs",
    "migration:import:lions-media:local": "eval \"$(supabase status -o env 2>/dev/null)\"; NEXT_PUBLIC_SUPABASE_URL=\"$API_URL\" NEXT_PUBLIC_SUPABASE_ANON_KEY=\"$ANON_KEY\" SUPABASE_SERVICE_ROLE_KEY=\"$SERVICE_ROLE_KEY\" SUPABASE_DB_URL=\"$DB_URL\" tsx scripts/import-lions-media-local.ts --execute-local --confirm-local",
    "migration:import:diverse-city:local": "eval \"$(supabase status -o env 2>/dev/null)\"; NEXT_PUBLIC_SUPABASE_URL=\"$API_URL\" NEXT_PUBLIC_SUPABASE_ANON_KEY=\"$ANON_KEY\" SUPABASE_SERVICE_ROLE_KEY=\"$SERVICE_ROLE_KEY\" SUPABASE_DB_URL=\"$DB_URL\" tsx scripts/import-diverse-city-local.ts --execute-local --confirm-local",
    "migration:rehearse:diverse-city:local": "eval \"$(supabase status -o env 2>/dev/null)\"; NEXT_PUBLIC_SUPABASE_URL=\"$API_URL\" NEXT_PUBLIC_SUPABASE_ANON_KEY=\"$ANON_KEY\" SUPABASE_SERVICE_ROLE_KEY=\"$SERVICE_ROLE_KEY\" SUPABASE_DB_URL=\"$DB_URL\" tsx scripts/import-diverse-city-local.ts --execute-local --confirm-local --rehearse",
    "migration:reset:diverse-city:local": "eval \"$(supabase status -o env 2>/dev/null)\"; NEXT_PUBLIC_SUPABASE_URL=\"$API_URL\" NEXT_PUBLIC_SUPABASE_ANON_KEY=\"$ANON_KEY\" SUPABASE_SERVICE_ROLE_KEY=\"$SERVICE_ROLE_KEY\" SUPABASE_DB_URL=\"$DB_URL\" tsx scripts/import-diverse-city-local.ts --execute-local --confirm-local --reset-only",
    "migration:import:rose-city": "tsx scripts/import-rose-city-local.ts",
    "migration:import:rose-city:production": "node --import tsx scripts/import-rose-city-production.ts",
    "migration:plan:lions-media": "tsx scripts/plan-lions-media-import.ts",
    "migration:plan:diverse-city": "tsx scripts/plan-diverse-city-import.ts --dry-run",
    "migration:plan:rose-city": "tsx scripts/plan-rose-city-import.ts",
    "migration:reconcile:rose-city": "node scripts/reconcile-rose-city-export.mjs",
    "migration:reset:rose-city": "tsx scripts/import-rose-city-local.ts",
    "operator:enroll-totp": "tsx scripts/enroll-operator-totp.ts",
    "operator:verify-staging-auth": "tsx scripts/verify-operator-staging-auth.ts",
    "operator:smoke": "tsx scripts/smoke-operator-workflows.ts",
    "staging:verify:phase-7:lifecycle:legacy": "tsx scripts/verify-phase-7-lifecycle.ts",
    "staging:verify:media": "tsx scripts/verify-phase-7-media.ts",
    "staging:verify:phase-7:stripe:legacy": "tsx scripts/verify-phase-7-stripe-webhook.ts",
    "staging:backfill:plat-102": "tsx scripts/backfill-plat-102-staging.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@headlessui/react": "^2.2.10",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@vercel/analytics": "^2.0.1",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flag-icons": "^7.5.0",
    "gsap": "^3.12.5",
    "lucide-react": "^1.31.0",
    "motion": "^13.0.0",
    "next": "15.5.22",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "sharp": "0.35.0",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^8",
    "eslint-config-next": "15.5.22",
    "pg": "^8.22.0",
    "pngjs": "^7.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.18",
      "sharp": "0.35.0"
    }
  }
}

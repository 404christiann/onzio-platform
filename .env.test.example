# Local Supabase only. Tests reject hosted URLs.
SUPABASE_LOCAL=1
SUPABASE_TEST_URL=http://127.0.0.1:54321
# Supabase CLI 2.109+ reports these as PUBLISHABLE_KEY and SECRET_KEY.
# Older CLI versions may report equivalent ANON_KEY and SERVICE_ROLE_KEY values.
SUPABASE_TEST_ANON_KEY=local-publishable-or-anon-key-from-supabase-status
SUPABASE_TEST_SERVICE_ROLE_KEY=local-secret-or-service-role-key-from-supabase-status

# Stripe test-mode values only. Tests reject sk_live_ and whsec_live-style values.
STRIPE_TEST_SECRET_KEY=sk_test_contract_only
STRIPE_TEST_WEBHOOK_SECRET=whsec_test_contract_only
STRIPE_PRICE_ID_STARTER=price_test_starter
STRIPE_PRICE_ID_PRO=price_test_pro

# Stripe Connect — club registration payments (direct charges on the club's own
# connected Standard account; Onzio takes no fee and never touches the funds).
#
# TEST MODE ONLY IN THIS PHASE. No club has signed for live registration
# payments yet, so no live-mode Connect key exists in any environment. There is
# deliberately NO STRIPE_CONNECT_LIVE_SECRET_KEY and NO
# STRIPE_CONNECT_LIVE_WEBHOOK_SECRET here, and none should be added until a club
# has signed: `lib/stripe/connect-config.ts` refuses to construct a live client
# unless BOTH `onzio.clubs.payments_live_enabled` is true AND a live key is
# present, so withholding the key is one of the two independent guards. A
# contract test asserts that no `.env*.example` file defines one.
#
# These are separate variables from STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET
# above, which belong to Onzio's own subscription billing. The two must never
# share a key or a signing secret.
STRIPE_CONNECT_TEST_SECRET_KEY=sk_test_connect_contract_only
STRIPE_CONNECT_TEST_WEBHOOK_SECRET=whsec_test_connect_contract_only

    "features": [
      {
        "title": "The Name",
        "description": "Rose City Futbol Club’s club crest reflects Pasadena’s rich history and what makes the city special as a global city.",
        "patch_url": "http://127.0.0.1:55321/storage/v1/object/public/onzio-media/32ceba0b-4e25-52c2-bb6b-d82fb87637a7/about/448392e0-eddd-5e75-ae34-c62498cb0f01.webp",
        "icon_url": "http://127.0.0.1:55321/storage/v1/object/public/onzio-media/32ceba0b-4e25-52c2-bb6b-d82fb87637a7/about/fb42eb80-2a24-5219-a4de-72b90155f168.webp",
        "icon_size": 68,
        "icon_scale": 1
      },
      {
        "title": "The Rose",
        "description": "The rose symbolizes the world-famous Rose Parade that began January 1, 1890 and has run every year since. Residents, many from the snowy Midwest, covered their horse-drawn wagons in roses to display the area’s vitality in winter.",
        "patch_url": "http://127.0.0.1:55321/storage/v1/object/public/onzio-media/32ceba0b-4e25-52c2-bb6b-d82fb87637a7/about/834548f2-561b-59b6-a2c7-92e5ce724fbb.webp",
        "icon_url": "http://127.0.0.1:55321/storage/v1/object/public/onzio-media/32ceba0b-4e25-52c2-bb6b-d82fb87637a7/about/871a5921-1454-51fa-ab7a-6345b4d172b1.webp",
        "icon_size": 56,
        "icon_scale": 1
      },
      {
        "title": "The #23",
        "description": "Pasadena’s 23 square miles is home to 138,000 residents, the Rose Bowl stadium, and is located at the northern origin of the 110 freeway, the first freeway in the U.S.",
        "patch_url": "http://127.0.0.1:55321/storage/v1/object/public/onzio-media/32ceba0b-4e25-52c2-bb6b-d82fb87637a7/about/27d64830-218b-50a1-a96f-61046a8e4907.webp",
        "icon_url": "http://127.0.0.1:55321/storage/v1/object/public/onzio-media/32ceba0b-4e25-52c2-bb6b-d82fb87637a7/about/b74358ec-bed1-562e-afbb-c783a9fb03a8.webp",
        "icon_size": 112,
        "icon_scale": 1
      },
      {
        "title": "The #Crown",
        "description": "The San Gabriel Mountains crown the area with rugged majesty. Hiking trails lead to mountain peaks overseeing the entire Los Angeles basin.",
        "patch_url": "http://127.0.0.1:55321/storage/v1/object/public/onzio-media/32ceba0b-4e25-52c2-bb6b-d82fb87637a7/about/5bbd000b-1aef-5c26-a8fb-5886a21e453c.webp",
        "icon_url": "http://127.0.0.1:55321/storage/v1/object/public/onzio-media/32ceba0b-4e25-52c2-bb6b-d82fb87637a7/about/c157ce70-cfa0-5157-a5f6-348463802091.webp",
        "icon_size": 94,
        "icon_scale": 1
      },
      {
        "title": "The Key",
        "description": "Pasadena is the most prominent city in the San Gabriel Valley and derives its name from the Chippewa language meaning “Key of the Valley” and “Crown of the Valley.” Pasadena is “key” to artistic, educational and scientific institutions of global renown.",
        "patch_url": "http://127.0.0.1:55321/storage/v1/object/public/onzio-media/32ceba0b-4e25-52c2-bb6b-d82fb87637a7/about/f352748e-f2b8-51d0-a612-a942f3d62316.webp",
        "icon_url": "http://127.0.0.1:55321/storage/v1/object/public/onzio-media/32ceba0b-4e25-52c2-bb6b-d82fb87637a7/about/9a771a8f-6a16-589b-a6dc-6e82addfe542.webp",
        "icon_size": 55,
        "icon_scale": 1
      },
      {
        "title": "The Stem",
        "description": "Stem description goes here. Add the meaning of this crest detail in the admin portal.",
        "patch_url": "http://127.0.0.1:55321/storage/v1/object/public/onzio-media/32ceba0b-4e25-52c2-bb6b-d82fb87637a7/about/96ddc2aa-42dc-51e3-aad6-84e36adf4239.webp",

  "content": {
    "annotated_image_url": "http://127.0.0.1:55321/storage/v1/object/public/onzio-media/32ceba0b-4e25-52c2-bb6b-d82fb87637a7/about/fb583fb5-6ef9-5b40-a56d-d3e2f00b9c6d.webp",
